# Copy to .env next to compose.yaml (chmod 600). Never commit the real file.
# Every relay variable is documented in docs/SELF_HOSTING.md.
# The relay sits behind a reverse proxy: trust its X-Real-IP / X-Forwarded-For headers.
TRUST_PROXY=true
# Shared secret the reverse proxy sends as X-Forwarded-Secret (>= 16 characters).
FORWARDED_SECRET=change-me-to-the-proxy-secret
# Host address the container port is published on (a private interface the proxy reaches).
BIND_ADDRESS=192.0.2.10
# Optional: comma separated Origin allow list (exact origins, scheme://host:* for any port, or *).
# ALLOWED_ORIGINS=https://henry00is.github.io,http://localhost:*,http://127.0.0.1:*,views://main_ui
# Second instance for testing on the same host only. Never set these on a public relay.
# PORT=8091
# COMPOSE_PROJECT_NAME=aiworlded-relay-test
# CONTAINER_NAME=aiworlded-relay-test
# IMAGE_TAG=test
# WEBSOCKET_PATH=/wstest
# Allow internal test rooms (default false), also through the proxy, so test suites can use them.
# INTERNAL_TEST_ROOMS=true
# INTERNAL_TEST_ROOMS_VIA_PROXY=true
# Raise per-IP limits (defaults 24 connections, 8 rooms): all test clients share one address.
# CONNECTIONS_PER_IP=96
# ROOMS_PER_IP=48
# Raise the room create/join rate per IP (defaults 30/min, burst 10) for the same reason.
# ROOM_ENTRIES_PER_IP_PER_MINUTE=6000
# ROOM_ENTRY_BURST_PER_IP=1000

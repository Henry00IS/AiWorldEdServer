# Copy to .env on the server (chmod 600). Never commit the real file.
# Shared secret the reverse proxy sends as X-Forwarded-Secret (>= 16 characters).
FORWARDED_SECRET=change-me-to-the-proxy-secret
# Host address the container port is published on (the private 192.0.2.x interface).
BIND_ADDRESS=192.0.2.10
# Optional: comma separated Origin allow list (exact origins, or scheme://host:* for any port).
# ALLOWED_ORIGINS=https://henry00is.github.io,http://localhost:*,http://127.0.0.1:*,views://main_ui
# Optional: set to "false" to refuse internal test rooms entirely.
# INTERNAL_TEST_ROOMS=true

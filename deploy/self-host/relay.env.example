# Copy to relay.env next to compose.yaml. Every variable is optional; the full list with
# defaults is in docs/SELF_HOSTING.md.
#
# Pages allowed to connect, comma separated. Add the address your editor is served from.
# ALLOWED_ORIGINS=https://editor.example.com,http://localhost:*,views://main_ui
#
# Serve wss:// directly (files mounted from ./certs).
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem
#
# Behind a reverse proxy: trust its X-Real-IP / X-Forwarded-For headers. Set a secret the
# proxy sends as X-Forwarded-Secret when the relay port is reachable by anyone else.
# TRUST_PROXY=true
# FORWARDED_SECRET=a-long-random-string
#
# Room size.
# USERS_PER_ROOM_DEFAULT=16
# USERS_PER_ROOM_MAX=32
